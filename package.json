{
  "name": "@omniforce/mcp",
  "version": "0.1.5",
  "mcpName": "io.github.rmb/omniforce-mcp",
  "description": "Model Context Protocol (MCP) server for OmniForce — GEO & AI-search visibility. Audit any site's AI-search readiness and query your tracked prompts, competitors, visibility runs, and reports from any MCP client.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "omniforce-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "geo",
    "generative-engine-optimization",
    "aeo",
    "answer-engine-optimization",
    "ai-search",
    "ai-visibility",
    "llm",
    "omniforce",
    "claude",
    "cursor"
  ],
  "homepage": "https://www.omniforce.run/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmb/omniforce-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rmb/omniforce-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
